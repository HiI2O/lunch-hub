# ===========================================
# Lunch Hub Backend - 環境変数
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env
#
# ⚠️ 実際の値を設定してからアプリを起動してください
# ⚠️ このファイルに本物のパスワードやシークレットを書かないでください

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>
DB_NAME=lunch_hub

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------
# JWT
# -------------------------------------------
# 以下のコマンドでランダムな値を生成してください:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=<generate-random-secret>
JWT_REFRESH_SECRET=<generate-random-secret>

# -------------------------------------------
# セルフサインアップ用 PIN
# -------------------------------------------
COMPANY_PIN=<your-company-pin>

# -------------------------------------------
# メール送信 (開発環境: MailHog)
# -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@lunch-hub.local

# -------------------------------------------
# アプリケーション
# -------------------------------------------
APP_URL=http://localhost:5173
PORT=3000
TZ=Asia/Tokyo

# -------------------------------------------
# 初期管理者アカウント (シード用)
# -------------------------------------------
ADMIN_EMAIL=<admin-email@example.com>
ADMIN_PASSWORD=<strong-password-here>
ADMIN_DISPLAY_NAME=管理者
